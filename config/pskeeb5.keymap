#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUM1    1
#define ZH_CN   2
#define NUM2    3
#define SYM     4
#define FUNC    5
#define NAV     6

// #define SYM     2
// #define MEDIA   4
// #define MOUSE   5
// #define WINNAV  6

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            layers = <0>;
            timeout-ms = <50>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        combo_ctrl_backspace {
            bindings = <&kp RC(BACKSPACE)>;
            key-positions = <22 23>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <28 27>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_ctrl_shift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <20 21>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            layers = <0>;
        };

        combo_alt_shift {
            bindings = <&kp LA(LEFT_SHIFT)>;
            key-positions = <13 12>;
            timeout-ms = <50>;
        };
    };
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hs: homerow_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "POSITIONAL_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;    // <---[[the W key]]
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            lazy;
            ignore-modifiers;
        };

        td_leftShift: tap_dance_left_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LSHIFT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&skq LSHIFT>, <&kp LSHIFT>;
        };

        td_rightShift: tap_dance_right_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RSHIFT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&skq RSHIFT>, <&kp RSHIFT>;
        };

        td_leftGui: tap_dance_left_gui {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LGUI";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&skq LWIN>, <&kp LWIN>;
        };

        td_rightGui: tap_dance_right_gui {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RGUI";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&skq RWIN>, <&kp RWIN>;
        };

        td_numLayer1: tap_dance_num_layer1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUM_LAYER1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&to 2>, <&to 0>;
        };

        td_numLayer2: tap_dance_num_layer2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUM_LAYER2";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&to 0>, <&to 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Default";
            bindings = <
&kp Q             &kp W          &kp E  &kp R      &kp T  &kp Y  &kp U           &kp I      &kp O       &kp P
&kp A             &kp S          &kp D  &kp F      &kp G  &kp H  &kp J           &kp K      &kp L       &kp SEMICOLON
&kp Z             &kp X          &kp C  &kp V      &kp B  &kp N  &kp M           &kp COMMA  &kp DOT     &kp FSLH
&kp C_PLAY_PAUSE  &kp BACKSPACE  &to 1  &kp SPACE                &kp LEFT_SHIFT  &sl 4      &kp ESCAPE  &kp C_MUTE
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        num_layer1 {
            bindings = <
&kp PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS        &trans  &trans      &trans          &trans        &trans
&kp ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp EQUAL        &trans  &skq RCTRL  &td_rightShift  &td_rightGui  &kp RIGHT_ALT
&kp SLASH     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0  &trans  &trans      &trans          &trans        &trans
&trans        &trans           &td_numLayer1    &kp ENTER                                 &trans      &mo 6           &kp DELETE    &trans
            >;

            label = "Numbers1";
        };

        chinese_layer {
            label = "Chinese";
            bindings = <
&trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans        &trans  &trans      &trans          &trans        &trans
&trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans        &trans  &skq RCTRL  &td_rightShift  &td_rightGui  &kp RIGHT_ALT
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &trans  &trans      &trans          &trans        &trans
&trans  &trans        &to 3         &kp SPACE                           &trans      &trans          &trans        &trans
            >;
        };

        num_layer2 {
            label = "Numbers2";
            bindings = <
&kp PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS        &trans  &trans      &trans          &trans        &trans
&kp ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp EQUAL        &trans  &skq RCTRL  &td_rightShift  &td_rightGui  &kp RIGHT_ALT
&kp SLASH     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0  &trans  &trans      &trans          &trans        &trans
&trans        &trans           &td_numLayer2    &kp ENTER                                 &trans      &mo 5           &kp DELETE    &trans
            >;
        };

        symbol_layer {
            label = "Symbols";
            bindings = <
&kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE       &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AMPERSAND  &kp BACKSLASH
&kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND  &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES
&kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &kp AT_SIGN  &kp COLON             &kp COMMA              &kp PERIOD     &kp SINGLE_QUOTE
&trans           &trans         &mo 5             &trans                                         &trans                &mo 3                  &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>,
                <&inc_dec_kp C_NEXT K_PREV>;
        };

        function_layer {
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &kp KP_NUMLOCK  &kp F7  &kp F8  &kp F9  &kp F12
&skq LEFT_ALT  &td_leftGui   &td_leftShift  &skq LCTRL    &bt BT_CLR    &none           &kp F4  &kp F5  &kp F6  &kp F11
&none          &none         &none          &none         &none         &none           &kp F1  &kp F2  &kp F3  &kp F10
&trans         &trans        &mo 6          &trans                                      &trans  &trans  &trans  &trans
            >;

            label = "Function";
        };

        nav_layer {
            bindings = <
&trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &mkp MB4  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5  &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT        &trans
&trans  &trans          &mkp MCLK       &trans           &trans    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans
&trans  &trans          &trans          &trans                                     &trans          &trans        &trans           &trans
            >;

            label = "Navigation";
        };
    };
};
