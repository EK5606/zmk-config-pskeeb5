#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define ZH_CN   1
#define NUM1    2
#define SYM     3
#define FUNC    4
#define NAV     5

// #define SYM     2
// #define MEDIA   4
// #define MOUSE   5
// #define WINNAV  6

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <13 12>;
            layers = <0 1 2>;
            timeout-ms = <50>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <1 0>;
            timeout-ms = <50>;
            layers = <0 1 2>;
        };

        combo_nav_layer {
            bindings = <&to 5>;
            key-positions = <36 35>;
            timeout-ms = <50>;
        };

    };
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hs: homerow_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "POSITIONAL_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;    // <---[[the W key]]
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            lazy;
            ignore-modifiers;
        };

        sk_q: sticky_key_gui {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_GUI";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            lazy;
            ignore-modifiers;
        };

        td_leftShift: tap_dance_left_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LSHIFT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&skq LSHIFT>, <&kp LSHIFT>;
        };

        td_rightShift: tap_dance_right_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RSHIFT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&skq RSHIFT>, <&kp RSHIFT>;
        };

        td_leftGui: tap_dance_left_gui {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LGUI";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk_q LWIN>, <&kp LWIN>;
        };

        td_rightGui: tap_dance_right_gui {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RGUI";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk_q RWIN>, <&kp RWIN>;
        };

        td_shift_caps: td_shift_capsword {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SHIFT_CAPSWORD";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHIFT>, <&caps_word>;
        };

        mtl: momentary_toggle_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_MO_TAP_TOG";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Default";
            bindings = <
&kp Q             &kp W          &kp E     &kp R      &kp T  &kp Y  &kp U           &kp I      &kp O       &kp P
&kp A             &kp S          &kp D     &kp F      &kp G  &kp H  &kp J           &kp K      &kp L       &kp SEMICOLON
&kp Z             &kp X          &kp C     &kp V      &kp B  &kp N  &kp M           &kp COMMA  &kp DOT     &kp FSLH
&kp C_PLAY_PAUSE  &kp BACKSPACE  &mtl 2 1  &kp SPACE                &td_shift_caps  &sl 3      &kp ESCAPE  &kp C_MUTE
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        chinese_layer {
            label = "Chinese";
            bindings = <
&kp GRAVE  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS     &trans  &trans          &trans          &trans        &trans
&none      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL     &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
&none      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &trans  &trans          &trans          &trans        &trans
&trans     &trans        &trans        &trans                              &trans          &sl 3           &kp DELETE    &trans
            >;
        };

        num_layer {
            bindings = <
&kp PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS        &trans  &trans      &trans          &trans        &trans
&kp SLASH     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp EQUAL        &trans  &skq RCTRL  &td_rightShift  &td_rightGui  &kp RIGHT_ALT
&kp ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0  &trans  &trans      &trans          &trans        &trans
&trans        &trans           &none            &trans                                    &trans      &mo 4           &trans        &trans
            >;

            label = "Numbers";
        };

        symbol_layer {
            label = "Symbols";
            bindings = <
&kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE       &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AMPERSAND  &kp BACKSLASH
&kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND  &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES
&kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &kp AT_SIGN  &kp COLON             &kp COMMA              &kp PERIOD     &kp SINGLE_QUOTE
&trans           &trans         &mo 4             &trans                                         &trans                &mo 4                  &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>,
                <&inc_dec_kp C_NEXT K_PREV>;
        };

        function_layer {
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4    &kp KP_NUMLOCK  &kp F7  &kp F8  &kp F9  &kp F12
&skq LEFT_ALT  &td_leftGui     &td_leftShift  &skq LCTRL    &skq RIGHT_ALT  &none           &kp F4  &kp F5  &kp F6  &kp F11
&bootloader    &studio_unlock  &sys_reset     &out OUT_TOG  &bt BT_CLR      &none           &kp F1  &kp F2  &kp F3  &kp F10
&trans         &trans          &mo 5          &trans                                        &trans  &trans  &trans  &trans
            >;

            label = "Function";
        };

        nav_layer {
            bindings = <
&msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &mkp MB4  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP   &kp END    &trans
&msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5  &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
&trans          &trans          &mkp MCLK       &trans           &trans    &trans    &trans         &trans        &trans     &trans
&trans          &trans          &to 0           &trans                               &trans         &none         &trans     &trans
            >;

            label = "Navigation";
        };
    };
};
